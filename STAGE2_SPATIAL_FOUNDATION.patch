+assert(scheduleForLevel(20)?.tier === "castle_expand", "L20 retains the final castle expansion stage");
+assert(perimeterForRadius(94).fMin === -94 && perimeterForRadius(94).sMax === 94, "perimeterForRadius returns an R94 square");
