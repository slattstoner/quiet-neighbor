+import fs from "node:fs";
+import {
+  FINAL_RADIUS,
+  WALL_INNER_FACE,
+  TOWER_INNER_FACE,
+  PERIMETER_SCHEDULE,
+  ROAD_AXES,
+  GATE_SPECS,
