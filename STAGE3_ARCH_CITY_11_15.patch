+console.log("\n=== city builders 11–15: all four orientations ===");
+
+for (let facing = 0; facing < 4; facing++) {
+  for (let index = 0; index < CITY_BUILDING_IDS.length; index++) {
+    const buildingId = CITY_BUILDING_IDS[index];
